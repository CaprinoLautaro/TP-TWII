// Modelo de datos de la tienda (PostgreSQL). Para cambiarlo:
//   1) editar este archivo
//   2) npm run db:migrate   (pide un nombre para la migración, ej: "agregar-telefono")
//   3) subir a Git también la carpeta prisma/migrations
// Cuando alguien cambie el schema, el resto hace "git pull" y "npm run db:migrate".

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  CLIENTE
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String // se guarda HASHEADA (bcrypt), nunca en texto plano
  nombre    String
  apellido  String
  direccion String
  rol       Rol      @default(CLIENTE)
  createdAt DateTime @default(now())

  resetTokenHash String?
  resetTokenExpiresAt DateTime?


  cartItems CartItem[]
  orders    Order[]
}

/// Categorías de producto. El admin puede agregar nuevas desde la app.
/// Product.clasificacion guarda el nombre de la categoría (texto), validado contra esta tabla.
model Categoria {
  id        Int      @id @default(autoincrement())
  nombre    String   @unique
  createdAt DateTime @default(now())
}

model Product {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique
  descripcion   String
  clasificacion String // nombre de una Categoria (Alimento, Juguetes, ...)
  precio        Int // en pesos, sin decimales
  stock         Int      @default(0)
  imagen        String   @default("")
  createdAt     DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model CartItem {
  id        Int @id @default(autoincrement())
  userId    Int
  productId Int
  cantidad  Int @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id                   Int      @id @default(autoincrement())
  userId               Int
  total                Int
  metodoPago           String   @default("") // medio de pago elegido (Efectivo, Transferencia, Tarjeta...)
  ultimosDigitosTarjeta String? // solo los últimos 4 dígitos; nunca se guardan datos completos de la tarjeta
  createdAt            DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]
}

model OrderItem {
  id             Int @id @default(autoincrement())
  orderId        Int
  productId      Int
  cantidad       Int
  precioUnitario Int // precio al momento de comprar

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}
